# Development Settings
PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=ziptrrip-todo-dev-secret-key-change-in-production

# MongoDB Atlas Connection String (required)
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/todo-app?retryWrites=true&w=majority

# Render Production Settings (Configure on Render Dashboard):
# PORT=<auto-assigned by Render>
# NODE_ENV=production
# CLIENT_ORIGIN=https://todo-app-smoky-pi-40.vercel.app
# JWT_SECRET=your-secure-production-jwt-secret
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/todo-app?retryWrites=true&w=majority
